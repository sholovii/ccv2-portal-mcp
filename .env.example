# Copy to .env and fill in. .env is gitignored.
#
# Values come from the Cloud Portal: User Management -> Technical Users -> Create.
# The portal shows Token Endpoint URL, Client ID, Client Secret and Resource once.
# The technical user needs the CUSTOMER_DEVELOPER or CUSTOMER_SYS_ADMIN role and must be
# granted the environments you want the agent to see. Secrets expire; note the date.
#
# Subscription code = the segment after "subscription/" in the Cloud Portal URL.

# --- single subscription (flat) ---
CCV2_SUBSCRIPTION_NAME=acme
CCV2_SUBSCRIPTION_CODE=
CCV2_CLIENT_ID=
CCV2_CLIENT_SECRET=
CCV2_TOKEN_URL=https://ycloud.accounts.ondemand.com/oauth2/token
CCV2_RESOURCE=
# Per-environment permissions; unlisted environments get CCV2_DEFAULT_PERMISSIONS.
# Permissions: read, build, deploy, properties_write, endpoints_write, scaling, backup_restore
CCV2_PERMISSIONS=d1:read,build,deploy;s1:read,build,deploy;p1:read
CCV2_DEFAULT_PERMISSIONS=read

# --- several subscriptions, from variables only ---
# Names are free-form; each becomes an upper-case prefix (acme -> ACME_, globex-eu -> GLOBEX_EU_).
# <PREFIX>_TOKEN_URL, _DEFAULT_PERMISSIONS and _BASE_URL fall back to the CCV2_* values above.
# CCV2_SUBSCRIPTIONS=acme,globex-eu
# CCV2_DEFAULT_SUBSCRIPTION=acme
# ACME_SUBSCRIPTION_CODE=
# ACME_CLIENT_ID=
# ACME_CLIENT_SECRET=
# ACME_RESOURCE=
# ACME_PERMISSIONS=d1:read,build,deploy;p1:read
# GLOBEX_EU_SUBSCRIPTION_CODE=
# GLOBEX_EU_CLIENT_ID=
# GLOBEX_EU_CLIENT_SECRET=
# GLOBEX_EU_RESOURCE=
# GLOBEX_EU_PERMISSIONS=d1:read

# --- several subscriptions, from a JSON file (see config/config.example.json) ---
# CCV2_CONFIG=config/config.json        # ${VAR} placeholders in the file resolve from this env

# Transport for local runs; the container forces streamable-http.
MCP_TRANSPORT=stdio
MCP_PORT=8849

# Status page. Under streamable-http it is served on the MCP port (http://localhost:8849/).
# Under stdio run `ccv2-portal-mcp ui`, which binds to UI_HOST:UI_PORT.
UI_HOST=127.0.0.1
UI_PORT=8850

# Bounded waits: each wait_* call blocks at most this long, polling every WAIT_POLL_SEC.
WAIT_MAX_SEC=60
WAIT_POLL_SEC=15
# Lines returned from a build log at most.
BUILD_LOG_MAX_LINES=400
